#version 450 core
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer InputX { float16_t data[]; } X;
layout(set = 0, binding = 1) buffer InputW { float16_t data[]; } W;
layout(set = 0, binding = 2) buffer InputC { float16_t data[]; } C;
layout(set = 0, binding = 3) buffer OutputY { float16_t data[]; } Y;

f16vec4 loadInput(int k0)
{
    return f16vec4(X.data[k0 + 0], X.data[k0 + 1],
                   X.data[k0 + 2], X.data[k0 + 3]);
}

void tileWeight(int k0, int col0, out f16vec4 weight[4])
{
    weight[0] = f16vec4(W.data[(col0 + 0) * 32 + k0 + 0], W.data[(col0 + 0) * 32 + k0 + 1],
                        W.data[(col0 + 0) * 32 + k0 + 2], W.data[(col0 + 0) * 32 + k0 + 3]);
    weight[1] = f16vec4(W.data[(col0 + 1) * 32 + k0 + 0], W.data[(col0 + 1) * 32 + k0 + 1],
                        W.data[(col0 + 1) * 32 + k0 + 2], W.data[(col0 + 1) * 32 + k0 + 3]);
    weight[2] = f16vec4(W.data[(col0 + 2) * 32 + k0 + 0], W.data[(col0 + 2) * 32 + k0 + 1],
                        W.data[(col0 + 2) * 32 + k0 + 2], W.data[(col0 + 2) * 32 + k0 + 3]);
    weight[3] = f16vec4(W.data[(col0 + 3) * 32 + k0 + 0], W.data[(col0 + 3) * 32 + k0 + 1],
                        W.data[(col0 + 3) * 32 + k0 + 2], W.data[(col0 + 3) * 32 + k0 + 3]);
}

#define MatMul_PATTERN(k4, col0) \
    tileWeight(k4, col0, weight); \
    rx += v * weight[0];           \
    ry += v * weight[1];           \
    rz += v * weight[2];           \
    rw += v * weight[3];

void storeOutput(int col0, f16vec4 value)
{
    Y.data[col0 + 0] = value.x;
    Y.data[col0 + 1] = value.y;
    Y.data[col0 + 2] = value.z;
    Y.data[col0 + 3] = value.w;
}

void main()
{
    for (int col0 = 0; col0 < 16; col0 += 4) {
        f16vec4 rx = f16vec4(0.0hf);
        f16vec4 ry = f16vec4(0.0hf);
        f16vec4 rz = f16vec4(0.0hf);
        f16vec4 rw = f16vec4(0.0hf);
        f16vec4 weight[4];
        f16vec4 v;

        v = loadInput(0);
        MatMul_PATTERN(0, col0);
        v = loadInput(4);
        MatMul_PATTERN(4, col0);
        v = loadInput(8);
        MatMul_PATTERN(8, col0);
        v = loadInput(12);
        MatMul_PATTERN(12, col0);
        v = loadInput(16);
        MatMul_PATTERN(16, col0);
        v = loadInput(20);
        MatMul_PATTERN(20, col0);
        v = loadInput(24);
        MatMul_PATTERN(24, col0);
        v = loadInput(28);
        MatMul_PATTERN(28, col0);

        storeOutput(col0, f16vec4(
            rx.x + rx.y + rx.z + rx.w,
            ry.x + ry.y + ry.z + ry.w,
            rz.x + rz.y + rz.z + rz.w,
            rw.x + rw.y + rw.z + rw.w
        ));
    }
}
