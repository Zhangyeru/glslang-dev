#version 450 core
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer InputX { float16_t data[]; } X;
layout(set = 0, binding = 1) buffer InputW { float16_t data[]; } W;
layout(set = 0, binding = 2) buffer InputBias { float16_t data[]; } Bias;
layout(set = 0, binding = 3) buffer OutputY { float16_t data[]; } Y;

f16vec4 loadInput(int k0)
{
    return f16vec4(X.data[k0 + 0], X.data[k0 + 1],
                   X.data[k0 + 2], X.data[k0 + 3]);
}

f16vec4 loadBias(int col0)
{
    return f16vec4(Bias.data[col0 + 0], Bias.data[col0 + 1],
                   Bias.data[col0 + 2], Bias.data[col0 + 3]);
}

void tileWeight(int k0, int col0, out f16vec4 weight[4])
{
    weight[0] = f16vec4(W.data[(k0 + 0) * 16 + col0 + 0], W.data[(k0 + 1) * 16 + col0 + 0],
                        W.data[(k0 + 2) * 16 + col0 + 0], W.data[(k0 + 3) * 16 + col0 + 0]);
    weight[1] = f16vec4(W.data[(k0 + 0) * 16 + col0 + 1], W.data[(k0 + 1) * 16 + col0 + 1],
                        W.data[(k0 + 2) * 16 + col0 + 1], W.data[(k0 + 3) * 16 + col0 + 1]);
    weight[2] = f16vec4(W.data[(k0 + 0) * 16 + col0 + 2], W.data[(k0 + 1) * 16 + col0 + 2],
                        W.data[(k0 + 2) * 16 + col0 + 2], W.data[(k0 + 3) * 16 + col0 + 2]);
    weight[3] = f16vec4(W.data[(k0 + 0) * 16 + col0 + 3], W.data[(k0 + 1) * 16 + col0 + 3],
                        W.data[(k0 + 2) * 16 + col0 + 3], W.data[(k0 + 3) * 16 + col0 + 3]);
}

void storeOutput(int col0, f16vec4 value)
{
    Y.data[col0 + 0] = value.x;
    Y.data[col0 + 1] = value.y;
    Y.data[col0 + 2] = value.z;
    Y.data[col0 + 3] = value.w;
}

void main()
{
    for (int col0 = 0; col0 < 16; col0 += 4) {
        f16vec4 rx = f16vec4(0.0hf);
        f16vec4 ry = f16vec4(0.0hf);
        f16vec4 rz = f16vec4(0.0hf);
        f16vec4 rw = f16vec4(0.0hf);
        f16vec4 weight[4];
        for (int k0 = 0; k0 < 32; k0 += 4) {
            f16vec4 v = loadInput(k0);
            tileWeight(k0, col0, weight);
            rx += v * weight[0];
            ry += v * weight[1];
            rz += v * weight[2];
            rw += v * weight[3];
        }
        storeOutput(col0, loadBias(col0) + f16vec4(
            rx.x + rx.y + rx.z + rx.w,
            ry.x + ry.y + ry.z + ry.w,
            rz.x + rz.y + rz.z + rz.w,
            rw.x + rw.y + rw.z + rw.w));
    }
}
