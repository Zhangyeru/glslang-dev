#version 450 core
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer InputX {
    float16_t x[48];
} InX;

layout(set = 0, binding = 1) buffer PackedWeights {
    float16_t w1[8 * 8];
    float16_t w2[8 * 48];
    float16_t w3[48 * 8];
    float16_t w4[8 * 48];
    float16_t w5[48 * 4];
} Weights;

layout(set = 0, binding = 2) buffer PackedBias {
    float16_t b1[8];
    float16_t b2[48];
    float16_t b3[8];
    float16_t b4[48];
    float16_t b5[4];
} Biases;

layout(set = 0, binding = 3) buffer OutputY {
    float16_t y[4];
} OutY;

f16vec2 relu2(f16vec2 value)
{
    return max(value, f16vec2(0.0hf));
}

void main()
{
    const int narrowWidth = 8;
    const int wideWidth = 48;
    const int splitWidth = 16;

    /* ---- Layer 1: ordinary 8x8 lowering (N=8 too small to fuse with L2). ---- */

    float16_t h1[8];
    for (int col = 0; col < 8; ++col) {
        float16_t acc = Biases.b1[col];
        for (int k = 0; k < 8; ++k) {
            acc = fma(InX.x[k], Weights.w1[k * 8 + col], acc);
        }
        h1[col] = max(acc, float16_t(0));
    }

    /* ---- Fuse layers 2 and 3. ---- */

    f16vec2 h3[4];
    for (int outputPair = 0; outputPair < 4; ++outputPair) {
        int outputBase = outputPair * 2;
        h3[outputPair] = f16vec2(Biases.b3[outputBase], Biases.b3[outputBase + 1]);
    }

    for (int splitBegin = 0; splitBegin < wideWidth; splitBegin += splitWidth) {
        int splitEnd = min(splitBegin + splitWidth, wideWidth);
        for (int hidden = splitBegin; hidden < splitEnd; hidden += 2) {
            f16vec2 h2 = f16vec2(Biases.b2[hidden], Biases.b2[hidden + 1]);
            for (int k = 0; k < narrowWidth; ++k) {
                f16vec2 weight = f16vec2(Weights.w2[k * wideWidth + hidden],
                                         Weights.w2[k * wideWidth + hidden + 1]);
                h2 = fma(f16vec2(h1[k]), weight, h2);
            }
            h2 = relu2(h2);

            for (int outputPair = 0; outputPair < 4; ++outputPair) {
                int outputBase = outputPair * 2;
                f16vec2 weight0 = f16vec2(Weights.w3[hidden * narrowWidth + outputBase],
                                          Weights.w3[hidden * narrowWidth + outputBase + 1]);
                f16vec2 weight1 = f16vec2(Weights.w3[(hidden + 1) * narrowWidth + outputBase],
                                          Weights.w3[(hidden + 1) * narrowWidth + outputBase + 1]);
                h3[outputPair] = fma(f16vec2(h2.x), weight0, h3[outputPair]);
                h3[outputPair] = fma(f16vec2(h2.y), weight1, h3[outputPair]);
            }
        }
    }
    for (int outputPair = 0; outputPair < 4; ++outputPair) {
        h3[outputPair] = relu2(h3[outputPair]);
    }

    /* ---- Fuse layers 4 and 5. ---- */

    const int outputWidth2 = 4;

    f16vec2 y_acc[2];
    for (int outputPair = 0; outputPair < 2; ++outputPair) {
        int outputBase = outputPair * 2;
        y_acc[outputPair] = f16vec2(Biases.b5[outputBase], Biases.b5[outputBase + 1]);
    }

    for (int splitBegin = 0; splitBegin < wideWidth; splitBegin += splitWidth) {
        int splitEnd = min(splitBegin + splitWidth, wideWidth);
        for (int hidden = splitBegin; hidden < splitEnd; hidden += 2) {
            f16vec2 h4 = f16vec2(Biases.b4[hidden], Biases.b4[hidden + 1]);
            for (int k = 0; k < narrowWidth; ++k) {
                float16_t inputValue = h3[k / 2][k % 2];
                f16vec2 weight = f16vec2(Weights.w4[k * wideWidth + hidden],
                                         Weights.w4[k * wideWidth + hidden + 1]);
                h4 = fma(f16vec2(inputValue), weight, h4);
            }
            h4 = relu2(h4);

            for (int outputPair = 0; outputPair < 2; ++outputPair) {
                int outputBase = outputPair * 2;
                f16vec2 weight0 = f16vec2(Weights.w5[hidden * outputWidth2 + outputBase],
                                          Weights.w5[hidden * outputWidth2 + outputBase + 1]);
                f16vec2 weight1 = f16vec2(Weights.w5[(hidden + 1) * outputWidth2 + outputBase],
                                          Weights.w5[(hidden + 1) * outputWidth2 + outputBase + 1]);
                y_acc[outputPair] = fma(f16vec2(h4.x), weight0, y_acc[outputPair]);
                y_acc[outputPair] = fma(f16vec2(h4.y), weight1, y_acc[outputPair]);
            }
        }
    }
    for (int outputPair = 0; outputPair < 2; ++outputPair) {
        y_acc[outputPair] = relu2(y_acc[outputPair]);
    }

    OutY.y[0] = y_acc[0].x;
    OutY.y[1] = y_acc[0].y;
    OutY.y[2] = y_acc[1].x;
    OutY.y[3] = y_acc[1].y;
}
