void main()
{
    Features state;
    state.confidence = A.data[1];
    float historyWeight = clamp(A.data[0], 0.0, 1.0);
    for (int channel = 0; channel < 32; ++channel)
        state.value[channel] = A.data[4 + channel] * (1.0 - historyWeight)
                             + A.data[36 + channel] * historyWeight;
    state = denoiseBlock0(state);
    for (int channel = 0; channel < 32; ++channel)
        D.data[33 + channel] = state.value[channel];
    state = denoiseBlock1(state);
    for (int channel = 0; channel < 32; ++channel)
        D.data[65 + channel] = state.value[channel];
    state = denoiseBlock2(state);
    for (int channel = 0; channel < 32; ++channel)
        D.data[97 + channel] = state.value[channel];
    state = denoiseBlock3(state);
    for (int channel = 0; channel < 32; ++channel)
        D.data[129 + channel] = state.value[channel];
    state = denoiseBlock4(state);
    for (int channel = 0; channel < 32; ++channel)
        D.data[161 + channel] = state.value[channel];
    state = denoiseBlock5(state);
    for (int channel = 0; channel < 32; ++channel)
        D.data[193 + channel] = state.value[channel];
    state = denoiseBlock6(state);
    for (int channel = 0; channel < 32; ++channel)
        D.data[225 + channel] = state.value[channel];
    state = denoiseBlock7(state);
    for (int channel = 0; channel < 32; ++channel)
        D.data[257 + channel] = state.value[channel];
    for (int channel = 0; channel < 32; ++channel)
        D.data[1 + channel] = state.value[channel] * 0.75 + A.data[4 + channel] * 0.25;
    D.data[289] = state.confidence;
}
