#version 450 core


// Eight learned residual denoising blocks with temporal history and confidence gating.
// A: controls[4], current[32], history[32]. B: packed learned parameters.
// D: guard, result[32], stage checkpoints, metadata, guard.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Inputs { float data[]; } A;
layout(set = 0, binding = 1, std430) readonly buffer Parameters { float data[]; } B;
layout(set = 0, binding = 2, std430) buffer Outputs { float data[]; } D;

struct Features
{
    float value[32];
    float confidence;
};

// Block 0: independent 32 x 32 weights and biases at parameter element 0.
Features denoiseBlock0(Features previous)
{
    Features result;
    float detail[32];
    float correction[32];
    for (int outChannel = 0; outChannel < 32; ++outChannel)
    {
        float sum = 0.0;
        for (int inChannel = 0; inChannel < 32; ++inChannel)
            sum += previous.value[inChannel] * B.data[0 + inChannel * 32 + outChannel];
        detail[outChannel] = max(sum + B.data[1024 + outChannel], 0.0);
    }
    for (int outChannel = 0; outChannel < 32; ++outChannel)
    {
        float sum = 0.0;
        for (int inChannel = 0; inChannel < 32; ++inChannel)
            sum += detail[inChannel] * B.data[1056 + inChannel * 32 + outChannel];
        correction[outChannel] = clamp(sum + B.data[2080 + outChannel], -1.0, 1.0);
    }
    float gain = previous.confidence > 0.25 ? 0.25 : 0.125;
    for (int channel = 0; channel < 32; ++channel)
        result.value[channel] = clamp(previous.value[channel] + correction[channel] * gain, -2.0, 2.0);
    result.confidence = clamp(previous.confidence + correction[0] * 0.0625, 0.0, 1.0);
    return result;
}

