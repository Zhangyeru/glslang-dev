#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

// Eight dense stages with packed parameters and observable intermediate activations.
// Binding 0: input features followed by runtime activation controls.
// Binding 1: row-major weights followed by bias, with each matrix row-aligned.
// Row padding for the 48/64-column transitions is part of the flat layout.
// The complete parameter buffer has 18048 elements (including tail padding).
// Binding 2: a leading guard, all eight stage checkpoints, a trailing guard.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer InputFeatures { int data[]; } A;
layout(set = 0, binding = 1, std430) readonly buffer PackedParameters { int8_t data[]; } B;
layout(set = 0, binding = 2, std430) buffer Checkpoints { int data[]; } D;

struct Features8
{
    int value[8];
};

struct Features16
{
    int value[16];
};

struct Features32
{
    int value[32];
};

struct Features48
{
    int value[48];
};

struct Features64
{
    int value[64];
};

Features32 prepareFeatures()
{
    Features32 result;
    for (int lane = 0; lane < 32; ++lane) {
        result.value[lane] = clamp(A.data[lane], -96, 95);
    }
    return result;
}

// Stage 0: feature expansion; 2048 multiply-accumulates.
Features64 project0(Features32 inputFeatures)
{
    Features64 result;
    for (int column = 0; column < 64; ++column) {
        int accumulator = int(B.data[2048 + column]);
        for (int row = 0; row < 32; ++row) {
            int weight = int(B.data[0 + row * 64 + column]);
            int product = inputFeatures.value[row] * weight;
            accumulator = accumulator + product;
        }
        int shift = A.data[32];
        int halfStep = 1 << (shift - 1);
        accumulator = (accumulator + halfStep) >> shift;
        accumulator = clamp(accumulator, A.data[33] != 0 ? 0 : -96, 95);
        result.value[column] = accumulator;
        D.data[1 + column] = accumulator;
    }
    return result;
}

// Stage 1: residual refinement; 4096 multiply-accumulates.
Features64 project1(Features64 inputFeatures)
{
    Features64 result;
    for (int column = 0; column < 64; ++column) {
        int accumulator = int(B.data[6208 + column]);
        for (int row = 0; row < 64; ++row) {
            int weight = int(B.data[2112 + row * 64 + column]);
            int product = inputFeatures.value[row] * weight;
            accumulator = accumulator + product;
        }
        accumulator = accumulator + inputFeatures.value[column] * 2;
        int shift = A.data[32];
        int halfStep = 1 << (shift - 1);
        accumulator = (accumulator + halfStep) >> shift;
        accumulator = clamp(accumulator, A.data[33] != 0 ? 0 : -96, 95);
        result.value[column] = accumulator;
        D.data[65 + column] = accumulator;
    }
    return result;
}

// Stage 2: bottleneck projection; 3072 multiply-accumulates.
Features48 project2(Features64 inputFeatures)
{
    Features48 result;
    for (int column = 0; column < 48; ++column) {
        int accumulator = int(B.data[9360 + column]);
        for (int row = 0; row < 64; ++row) {
            int weight = int(B.data[6288 + row * 48 + column]);
            int product = inputFeatures.value[row] * weight;
            accumulator = accumulator + product;
        }
        int shift = A.data[32];
        int halfStep = 1 << (shift - 1);
        accumulator = (accumulator + halfStep) >> shift;
        accumulator = clamp(accumulator, A.data[33] != 0 ? 0 : -96, 95);
        result.value[column] = accumulator;
        D.data[129 + column] = accumulator;
    }
    return result;
}

// Stage 3: context expansion; 3072 multiply-accumulates.
Features64 project3(Features48 inputFeatures)
{
    Features64 result;
    for (int column = 0; column < 64; ++column) {
        int accumulator = int(B.data[12480 + column]);
        for (int row = 0; row < 48; ++row) {
            int weight = int(B.data[9408 + row * 64 + column]);
            int product = inputFeatures.value[row] * weight;
            accumulator = accumulator + product;
        }
        int shift = A.data[32];
        int halfStep = 1 << (shift - 1);
        accumulator = (accumulator + halfStep) >> shift;
        accumulator = clamp(accumulator, A.data[33] != 0 ? 0 : -96, 95);
        result.value[column] = accumulator;
        D.data[177 + column] = accumulator;
    }
    return result;
}

// Stage 4: context compression; 3072 multiply-accumulates.
Features48 project4(Features64 inputFeatures)
{
    Features48 result;
    for (int column = 0; column < 48; ++column) {
        int accumulator = int(B.data[15648 + column]);
        for (int row = 0; row < 64; ++row) {
            int weight = int(B.data[12576 + row * 48 + column]);
            int product = inputFeatures.value[row] * weight;
            accumulator = accumulator + product;
        }
        int shift = A.data[32];
        int halfStep = 1 << (shift - 1);
        accumulator = (accumulator + halfStep) >> shift;
        accumulator = clamp(accumulator, A.data[33] != 0 ? 0 : -96, 95);
        result.value[column] = accumulator;
        D.data[241 + column] = accumulator;
    }
    return result;
}

// Stage 5: latent projection; 1536 multiply-accumulates.
Features32 project5(Features48 inputFeatures)
{
    Features32 result;
    for (int column = 0; column < 32; ++column) {
        int accumulator = int(B.data[17248 + column]);
        for (int row = 0; row < 48; ++row) {
            int weight = int(B.data[15712 + row * 32 + column]);
            int product = inputFeatures.value[row] * weight;
            accumulator = accumulator + product;
        }
        int shift = A.data[32];
        int halfStep = 1 << (shift - 1);
        accumulator = (accumulator + halfStep) >> shift;
        accumulator = clamp(accumulator, A.data[33] != 0 ? 0 : -96, 95);
        result.value[column] = accumulator;
        D.data[289 + column] = accumulator;
    }
    return result;
}

// Stage 6: head bottleneck; 512 multiply-accumulates.
Features16 project6(Features32 inputFeatures)
{
    Features16 result;
    for (int column = 0; column < 16; ++column) {
        int accumulator = int(B.data[17792 + column]);
        for (int row = 0; row < 32; ++row) {
            int weight = int(B.data[17280 + row * 16 + column]);
            int product = inputFeatures.value[row] * weight;
            accumulator = accumulator + product;
        }
        int shift = A.data[32];
        int halfStep = 1 << (shift - 1);
        accumulator = (accumulator + halfStep) >> shift;
        accumulator = clamp(accumulator, A.data[33] != 0 ? 0 : -96, 95);
        result.value[column] = accumulator;
        D.data[321 + column] = accumulator;
    }
    return result;
}

// Stage 7: output head; 128 multiply-accumulates.
Features8 project7(Features16 inputFeatures)
{
    Features8 result;
    for (int column = 0; column < 8; ++column) {
        int accumulator = int(B.data[17936 + column]);
        for (int row = 0; row < 16; ++row) {
            int weight = int(B.data[17808 + row * 8 + column]);
            int product = inputFeatures.value[row] * weight;
            accumulator = accumulator + product;
        }
        result.value[column] = accumulator;
        D.data[337 + column] = accumulator;
    }
    return result;
}

void main()
{
    Features32 features = prepareFeatures();
    Features64 stage0 = project0(features);
    Features64 stage1 = project1(stage0);
    Features48 stage2 = project2(stage1);
    Features64 stage3 = project3(stage2);
    Features48 stage4 = project4(stage3);
    Features32 stage5 = project5(stage4);
    Features16 stage6 = project6(stage5);
    Features8 stage7 = project7(stage6);
}
