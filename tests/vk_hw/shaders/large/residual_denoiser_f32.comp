void main()
{
    Features state;
    state.confidence = A.data[1];
    float historyWeight = clamp(A.data[0], 0.0, 1.0);
    coopvecHW<float, 32> current;
    coopvecHW<float, 32> history;
    coopVecLoadHW(current, A.data, 4u);
    coopVecLoadHW(history, A.data, 36u);
    state.value = current * (1.0 - historyWeight) + history * historyWeight;
    state = denoiseBlock0(state);
    coopVecStoreHW(state.value, D.data, 33u);
    state = denoiseBlock1(state);
    coopVecStoreHW(state.value, D.data, 65u);
    state = denoiseBlock2(state);
    coopVecStoreHW(state.value, D.data, 97u);
    state = denoiseBlock3(state);
    coopVecStoreHW(state.value, D.data, 129u);
    state = denoiseBlock4(state);
    coopVecStoreHW(state.value, D.data, 161u);
    state = denoiseBlock5(state);
    coopVecStoreHW(state.value, D.data, 193u);
    state = denoiseBlock6(state);
    coopVecStoreHW(state.value, D.data, 225u);
    state = denoiseBlock7(state);
    coopVecStoreHW(state.value, D.data, 257u);
    state.value = state.value * 0.75 + current * 0.25;
    coopVecStoreHW(state.value, D.data, 1u);
    D.data[289] = state.confidence;
}
