#version 450 core
#extension GL_HW_neural_shader : require

// Eight learned residual denoising blocks with temporal history and confidence gating.
// A: controls[4], current[32], history[32]. B: packed learned parameters.
// D: guard, result[32], stage checkpoints, metadata, guard.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Inputs { float data[]; } A;
layout(set = 0, binding = 1, std430) readonly buffer Parameters { float data[]; } B;
layout(set = 0, binding = 2, std430) buffer Outputs { float data[]; } D;

struct Features
{
    coopvecHW<float, 32> value;
    float confidence;
};

// Block 0: independent 32 x 32 weights and biases at parameter element 0.
Features denoiseBlock0(Features previous)
{
    Features result;
    coopmatHW<float, 32, 32> analysisWeights;
    coopmatHW<float, 32, 32> synthesisWeights;
    coopvecHW<float, 32> analysisBias;
    coopvecHW<float, 32> synthesisBias;
    coopvecHW<float, 32> detail;
    coopvecHW<float, 32> correction;
    coopMatLoadHW(analysisWeights, B.data, ivec2(528, 32), ivec2(0, 0),
                  gl_CooperativeMatrixLayoutRowMajorHW);
    coopVecLoadHW(analysisBias, B.data, 1024u);
    coopVecMatMulAddHW(detail, previous.value, analysisWeights, analysisBias);
    detail = max(detail, coopvecHW<float, 32>(0.0));
    coopMatLoadHW(synthesisWeights, B.data, ivec2(528, 32), ivec2(33, 0),
                  gl_CooperativeMatrixLayoutRowMajorHW);
    coopVecLoadHW(synthesisBias, B.data, 2080u);
    coopVecMatMulAddHW(correction, detail, synthesisWeights, synthesisBias);
    correction = clamp(correction, coopvecHW<float, 32>(-1.0), coopvecHW<float, 32>(1.0));
    float gain;
    if (previous.confidence > 0.25)
        gain = 0.25;
    else
        gain = 0.125;
    result.value = clamp(previous.value + correction * gain,
                         coopvecHW<float, 32>(-2.0), coopvecHW<float, 32>(2.0));
    result.confidence = clamp(previous.confidence + correction[0] * 0.0625, 0.0, 1.0);
    return result;
}

