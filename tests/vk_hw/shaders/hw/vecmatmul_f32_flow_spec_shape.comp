#version 450 core
#extension GL_HW_neural_shader : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const int SPEC_INNER_BASE = 4;
layout(constant_id = 1) const int SPEC_COLUMNS_BASE = 2;

const int INNER = SPEC_INNER_BASE + 1;
const int COLUMNS = SPEC_COLUMNS_BASE + 1;

layout(set = 0, binding = 0) buffer InputX { float data[]; } X;
layout(set = 0, binding = 1) buffer InputW { float data[]; } W;
layout(set = 0, binding = 2) buffer InputC { float data[]; } C;
layout(set = 0, binding = 3) buffer OutputY { float data[]; } Y;

void main()
{
    const ivec2 matrixShape = ivec2(INNER, COLUMNS);
    const ivec2 zeroOffset = ivec2(0);
    coopvecHW<float, INNER> inputValue;
    coopmatHW<float, INNER, COLUMNS> weights;
    coopvecHW<float, COLUMNS> outputValue;

    coopVecLoadHW(inputValue, X.data, 0u);
    coopMatLoadHW(
        weights,
        W.data,
        matrixShape,
        zeroOffset,
        gl_CooperativeMatrixLayoutRowMajorHW);
    coopVecMatMulHW(outputValue, inputValue, weights);
    coopVecStoreHW(outputValue, Y.data, 0u);
}
