#version 450 core
#extension GL_HW_neural_shader : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer InputA { float16_t data[]; } A;
layout(set = 0, binding = 1) buffer InputB { float16_t data[]; } B;
layout(set = 0, binding = 2) buffer InputC { float16_t data[]; } C;
layout(set = 0, binding = 3) buffer OutputD { float16_t data[]; } D;

struct MatrixLeaf {
    coopmatHW<float16_t, 17, 25> value;
};

struct MatrixLayer {
    MatrixLeaf leaves[2];
};

struct MatrixGroup {
    MatrixLayer layers[2];
};

struct MatrixRoot {
    MatrixGroup groups[2];
};

void main()
{
    const ivec2 shape = ivec2(17, 25);
    const ivec2 zeroOffset = ivec2(0);

    coopmatHW<float16_t, 17, 25> inputValue;
    coopMatLoadHW(inputValue, A.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);

    MatrixRoot root;
    root.groups[1].layers[0].leaves[1].value = inputValue;
    coopmatHW<float16_t, 17, 25> result = root.groups[1].layers[0].leaves[1].value;
    coopMatStoreHW(result, D.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
}
