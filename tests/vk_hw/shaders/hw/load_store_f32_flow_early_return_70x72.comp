#version 450 core
#extension GL_HW_neural_shader : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer InputA { float data[]; } A;
layout(set = 0, binding = 1) buffer InputB { float data[]; } B;
layout(set = 0, binding = 2) buffer InputC { float data[]; } C;
layout(set = 0, binding = 3) buffer OutputD { float data[]; } D;

struct MatrixCarrier {
    coopmatHW<float, 70, 72> value;
};

MatrixCarrier carryWithEarlyReturn(MatrixCarrier value, bool stopEarly)
{
    if (stopEarly)
        return value;

    MatrixCarrier carried = value;
    for (uint iteration = 0u; iteration < 2u; ++iteration)
        carried.value = value.value;
    return carried;
}

void main()
{
    const ivec2 shape = ivec2(70, 72);
    const ivec2 zeroOffset = ivec2(0);

    coopmatHW<float, 70, 72> value;
    coopMatLoadHW(value, A.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    MatrixCarrier carried;
    carried.value = value;
    carried = carryWithEarlyReturn(carried, gl_LocalInvocationIndex == 0u);
    coopMatStoreHW(carried.value, D.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
}
