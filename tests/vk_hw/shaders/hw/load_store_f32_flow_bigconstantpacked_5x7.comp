#version 460 core
#extension GL_HW_neural_shader : require
#pragma use_replicated_composites
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) buffer InputA { float data[]; } A;
layout(set = 0, binding = 1) buffer InputB { float data[]; } B;
layout(set = 0, binding = 2) buffer InputC { float data[]; } C;
layout(set = 0, binding = 3) buffer OutputD { float data[]; } D;
const coopvecHW<float, 131066> HUGE = coopvecHW<float, 131066>(1.0);
void main()
{
    uint i = gl_GlobalInvocationID.x;
    float check = HUGE[int(i)] + HUGE[int(i + 131065)] - 2.0;
    coopmatHW<float, 5, 7> value;
    coopMatLoadHW(value, A.data, ivec2(5, 7), ivec2(0), 0);
    value = value + coopmatHW<float, 5, 7>(check);
    coopMatStoreHW(value, D.data, ivec2(5, 7), ivec2(0), 0);
}
