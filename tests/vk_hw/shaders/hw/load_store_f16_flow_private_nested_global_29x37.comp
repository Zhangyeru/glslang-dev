#version 450 core
#extension GL_HW_neural_shader : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer InputA { float16_t data[]; } A;
layout(set = 0, binding = 1) buffer InputB { float16_t data[]; } B;
layout(set = 0, binding = 2) buffer InputC { float16_t data[]; } C;
layout(set = 0, binding = 3) buffer OutputD { float16_t data[]; } D;

struct MatrixLeaf {
    coopmatHW<float16_t, 29, 37> value;
};

struct MatrixBranch {
    MatrixLeaf leaves[2];
};

struct MatrixRoot {
    MatrixBranch branches[2];
};

MatrixRoot privateMatrices;

void main()
{
    const ivec2 shape = ivec2(29, 37);
    const ivec2 zeroOffset = ivec2(0);

    coopmatHW<float16_t, 29, 37> value;
    coopMatLoadHW(value, A.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
    privateMatrices.branches[1].leaves[0].value = value;
    coopmatHW<float16_t, 29, 37> result = privateMatrices.branches[1].leaves[0].value;
    coopMatStoreHW(result, D.data, shape, zeroOffset, gl_CooperativeMatrixLayoutRowMajorHW);
}
