#version 450 core
#extension GL_HW_neural_shader : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer InputA {
    float16_t data[];
} A;

layout(set = 0, binding = 1) buffer InputB {
    float16_t data[];
} B;

layout(set = 0, binding = 2) buffer InputC {
    float16_t data[];
} C;

layout(set = 0, binding = 3) buffer OutputD {
    float16_t data[];
} D;

const int CFG_TRANSPORT_ROWS = 20;
const int CFG_TRANSPORT_COLUMNS = 20;
const int CFG_TRANSPORT_INNER = 20;
const int CFG_TRANSPORT_ROUTE_COUNT = 2;
const ivec2 CFG_TRANSPORT_SHAPE_A = ivec2(CFG_TRANSPORT_ROWS, CFG_TRANSPORT_INNER);
const ivec2 CFG_TRANSPORT_SHAPE_B = ivec2(CFG_TRANSPORT_INNER, CFG_TRANSPORT_COLUMNS);
const ivec2 CFG_TRANSPORT_SHAPE_D = ivec2(CFG_TRANSPORT_ROWS, CFG_TRANSPORT_COLUMNS);
const ivec2 CFG_TRANSPORT_ZERO_OFFSET = ivec2(0);

struct CfgTransportLeftMatrix {
    coopmatHW<float16_t, CFG_TRANSPORT_ROWS, CFG_TRANSPORT_INNER> value;
    uvec4 state;
};

struct CfgTransportWeightMatrix {
    coopmatHW<float16_t, CFG_TRANSPORT_INNER, CFG_TRANSPORT_COLUMNS> value;
    uvec4 state;
};

struct CfgTransportAccumulatorMatrix {
    coopmatHW<float16_t, CFG_TRANSPORT_ROWS, CFG_TRANSPORT_COLUMNS> value;
    uvec4 state;
};

struct CfgTransportMatrixLane {
    CfgTransportLeftMatrix left;
    CfgTransportWeightMatrix weights;
    uvec4 scheduling;
};

struct CfgTransportMatrixRequest {
    CfgTransportMatrixLane lanes[CFG_TRANSPORT_ROUTE_COUNT];
    CfgTransportAccumulatorMatrix accumulator;
    uint selectedLane;
    bool ready;
};

struct CfgTransportMatrixResult {
    coopmatHW<float16_t, CFG_TRANSPORT_ROWS, CFG_TRANSPORT_COLUMNS> value;
    uvec4 completion;
};

struct CfgTransportVectorInput {
    coopvecHW<float16_t, CFG_TRANSPORT_INNER> value;
    uvec4 state;
};

struct CfgTransportVectorBias {
    coopvecHW<float16_t, CFG_TRANSPORT_COLUMNS> value;
    uvec4 state;
};

struct CfgTransportVectorResult {
    coopvecHW<float16_t, CFG_TRANSPORT_COLUMNS> value;
    uvec4 completion;
};

uint selectCfgTransportRoute()
{
    uint dispatchKey = gl_GlobalInvocationID.x ^ gl_LocalInvocationIndex;
    return dispatchKey & 1u;
}

CfgTransportLeftMatrix loadCfgTransportLeft()
{
    CfgTransportLeftMatrix result;
    coopMatLoadHW(
        result.value,
        A.data,
        CFG_TRANSPORT_SHAPE_A,
        CFG_TRANSPORT_ZERO_OFFSET,
        gl_CooperativeMatrixLayoutRowMajorHW);
    result.state = uvec4(CFG_TRANSPORT_ROWS, CFG_TRANSPORT_INNER, 0u, 1u);
    return result;
}

CfgTransportWeightMatrix loadCfgTransportWeights()
{
    CfgTransportWeightMatrix result;
    coopMatLoadHW(
        result.value,
        B.data,
        CFG_TRANSPORT_SHAPE_B,
        CFG_TRANSPORT_ZERO_OFFSET,
        gl_CooperativeMatrixLayoutRowMajorHW);
    result.state = uvec4(CFG_TRANSPORT_INNER, CFG_TRANSPORT_COLUMNS, 1u, 1u);
    return result;
}

CfgTransportAccumulatorMatrix loadCfgTransportAccumulator()
{
    CfgTransportAccumulatorMatrix result;
    coopMatLoadHW(
        result.value,
        C.data,
        CFG_TRANSPORT_SHAPE_D,
        CFG_TRANSPORT_ZERO_OFFSET,
        gl_CooperativeMatrixLayoutRowMajorHW);
    result.state = uvec4(CFG_TRANSPORT_ROWS, CFG_TRANSPORT_COLUMNS, 2u, 1u);
    return result;
}

CfgTransportMatrixRequest buildCfgTransportMatrixRequest(
    CfgTransportLeftMatrix left,
    CfgTransportWeightMatrix weights,
    CfgTransportAccumulatorMatrix accumulator,
    uint selectedLane)
{
    CfgTransportMatrixRequest request;
    request.accumulator = accumulator;
    request.selectedLane = selectedLane;
    request.ready =
        left.state.w != 0u &&
        weights.state.w != 0u &&
        accumulator.state.w != 0u;

    for (uint laneIndex = 0u;
         laneIndex < CFG_TRANSPORT_ROUTE_COUNT;
         ++laneIndex) {
        request.lanes[laneIndex].left = left;
        request.lanes[laneIndex].weights = weights;
        request.lanes[laneIndex].scheduling =
            uvec4(laneIndex, selectedLane, laneIndex == selectedLane ? 1u : 0u, 1u);
    }
    return request;
}

CfgTransportMatrixRequest stabilizeCfgTransportMatrixRequest(CfgTransportMatrixRequest request)
{
    uint selectedLane = request.selectedLane & 1u;
    CfgTransportMatrixLane resident = request.lanes[selectedLane];

    for (uint probe = 0u; probe < 3u; ++probe) {
        uint candidateIndex = (selectedLane + probe) & 1u;
        CfgTransportMatrixLane candidate = request.lanes[candidateIndex];
        bool candidateReady =
            candidate.left.state.w != 0u &&
            candidate.weights.state.w != 0u;
        resident = candidateReady ? candidate : resident;
    }

    switch (selectedLane) {
    case 0u:
        request.lanes[0] = resident;
        break;
    case 1u:
        request.lanes[1] = resident;
        break;
    default:
        request.lanes[0] = resident;
        request.selectedLane = 0u;
        break;
    }
    return request;
}

CfgTransportMatrixResult executeCfgTransportFirstMatrixPass(CfgTransportMatrixRequest request)
{
    uint laneIndex = request.selectedLane & 1u;
    CfgTransportMatrixLane lane = request.lanes[laneIndex];
    CfgTransportMatrixResult result;
    coopMatMulAddHW(
        result.value,
        lane.left.value,
        lane.weights.value,
        request.accumulator.value);
    result.completion =
        uvec4(0u, laneIndex, request.ready ? 1u : 0u, 1u);
    return result;
}

CfgTransportMatrixResult executeCfgTransportSecondMatrixPass(
    CfgTransportMatrixRequest request,
    CfgTransportMatrixResult firstPass)
{
    uint laneIndex = request.selectedLane & 1u;
    CfgTransportMatrixLane lane = request.lanes[laneIndex];
    CfgTransportMatrixResult result;
    coopMatMulAddHW(
        result.value,
        lane.left.value,
        lane.weights.value,
        firstPass.value);
    result.completion =
        uvec4(1u, laneIndex, firstPass.completion.w, 1u);
    return result;
}

void storeCfgTransportMatrixResult(CfgTransportMatrixResult result)
{
    coopMatStoreHW(
        result.value,
        D.data,
        CFG_TRANSPORT_SHAPE_D,
        CFG_TRANSPORT_ZERO_OFFSET,
        gl_CooperativeMatrixLayoutRowMajorHW);
}

CfgTransportVectorInput loadCfgTransportVectorInput()
{
    CfgTransportVectorInput inputValue;
    coopVecLoadHW(inputValue.value, A.data, 0u);
    inputValue.state = uvec4(CFG_TRANSPORT_INNER, 0u, 0u, 1u);
    return inputValue;
}

CfgTransportVectorBias loadCfgTransportVectorBias(uint passIndex)
{
    CfgTransportVectorBias bias;
    coopVecLoadHW(bias.value, D.data, 0u);
    bias.state = uvec4(CFG_TRANSPORT_COLUMNS, passIndex, 0u, 1u);
    return bias;
}

CfgTransportVectorResult executeCfgTransportVectorPass(
    CfgTransportVectorInput inputValue,
    CfgTransportWeightMatrix weights,
    CfgTransportVectorBias bias,
    uint passIndex)
{
    CfgTransportVectorResult result;
    coopVecMatMulAddHW(
        result.value,
        inputValue.value,
        weights.value,
        bias.value);
    result.completion =
        uvec4(passIndex, CFG_TRANSPORT_INNER, CFG_TRANSPORT_COLUMNS, 1u);
    return result;
}

void storeCfgTransportVectorResult(CfgTransportVectorResult result)
{
    coopVecStoreHW(result.value, D.data, 0u);
}

void main()
{
    uint selectedLane = selectCfgTransportRoute();
    CfgTransportLeftMatrix left = loadCfgTransportLeft();
    CfgTransportWeightMatrix weights = loadCfgTransportWeights();
    CfgTransportAccumulatorMatrix accumulator = loadCfgTransportAccumulator();

    CfgTransportMatrixRequest request =
        buildCfgTransportMatrixRequest(left, weights, accumulator, selectedLane);
    CfgTransportMatrixRequest stableRequest =
        stabilizeCfgTransportMatrixRequest(request);
    CfgTransportMatrixResult firstPass =
        executeCfgTransportFirstMatrixPass(stableRequest);
    CfgTransportMatrixResult secondPass =
        executeCfgTransportSecondMatrixPass(stableRequest, firstPass);
    storeCfgTransportMatrixResult(secondPass);

    CfgTransportVectorInput vectorInput = loadCfgTransportVectorInput();
    for (uint passIndex = 0u; passIndex < 2u; ++passIndex) {
        CfgTransportVectorBias bias = loadCfgTransportVectorBias(passIndex);
        CfgTransportVectorResult vectorResult =
            executeCfgTransportVectorPass(vectorInput, weights, bias, passIndex);
        storeCfgTransportVectorResult(vectorResult);
    }
}
