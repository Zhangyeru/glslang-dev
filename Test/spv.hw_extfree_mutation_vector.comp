#version 460 core
#extension GL_HW_neural_shader : require
#ifndef WIDTH
#define WIDTH 4
#endif
layout(local_size_x=1) in;
layout(set=0,binding=0) buffer InputA { float data[]; } A;
layout(set=0,binding=1) buffer InputB { float data[]; } B;
layout(set=0,binding=2) buffer Output { float data[]; } D;

void main()
{
    coopvecHW<float, WIDTH> inputValue, bias, result;
    coopmatHW<float, WIDTH, WIDTH> matrixValue;
    coopVecLoadHW(inputValue, A.data, 1u);
    coopVecLoadHW(bias, B.data, 1u);
    coopMatLoadHW(matrixValue, B.data, ivec2(WIDTH), ivec2(0), 1);
    uint index = gl_GlobalInvocationID.x % WIDTH;
    inputValue[index] = 7.0;
    bias[index] = 9.0;
    matrixValue[index] = 11.0;
    coopVecMatMulAddHW(result, inputValue, matrixValue, bias);
    coopVecStoreHW(result, D.data, 0u);
}
