#version 450 core
#extension GL_AD_cooperative_vector : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1) in;

void main()
{
    coopvecAD<int, 5> i32;
    coopvecAD<uint8_t, 5> u8;
    coopvecAD<float, 5> f32;
    coopvecAD<float16_t, 5> f16;

    floatBitsToInt(i32);
    uintBitsToFloat(u8);
    float16BitsToInt16(f32);
    int16BitsToFloat16(f16);
}
