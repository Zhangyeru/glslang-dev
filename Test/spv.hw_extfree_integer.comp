#version 460
#extension GL_HW_neural_shader : require
#ifndef WIDTH
#define WIDTH 4
#endif
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) buffer InputA { int data[]; } A;
layout(set = 0, binding = 1) buffer InputB { int data[]; } B;
layout(set = 0, binding = 2) buffer Output { int data[]; } D;

struct Result { coopmatHW<int, 3, 3> value; };
struct Left { coopmatHW<int, 3, 5> value; };
struct Right { coopmatHW<int, 5, 3> value; };
Result multiply(Left a, Right b, Result c)
{
    Result result;
    coopMatMulAddHW(result.value, a.value, b.value, c.value);
    return result;
}
void main()
{
    coopmatHW<int, 3, 5> a;
    coopmatHW<int, 5, 3> b;
    coopmatHW<int, 3, 3> c, other;
    coopMatLoadHW(a, A.data, ivec2(3, 5), ivec2(0), 0);
    coopMatLoadHW(b, B.data, ivec2(5, 3), ivec2(0), 0);
    coopMatLoadHW(c, A.data, ivec2(3), ivec2(0), 0);
    coopMatLoadHW(other, B.data, ivec2(3), ivec2(0), 0);
    coopmatHW<int, 3, 3> chosen = gl_GlobalInvocationID.x == 0u ? c : other;
    Left lhs;
    Right rhs;
    Result accumulator;
    lhs.value = a;
    rhs.value = b;
    accumulator.value = chosen;
    Result result = multiply(lhs, rhs, accumulator);
    coopMatStoreHW(result.value, D.data, ivec2(3), ivec2(0), 0);
}
