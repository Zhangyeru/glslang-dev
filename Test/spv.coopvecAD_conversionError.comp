#version 450 core
#extension GL_AD_cooperative_vector : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1) in;

void main()
{
    coopvecAD<float16_t, 5> f16;
    coopvecAD<float, 6> f32shape;
    coopvecAD<int16_t, 6> i16shape;

    coopvecAD<uint, 6>(f16);
    coopvecAD<int, 5>(f32shape);
    coopvecAD<float16_t, 5>(i16shape);
}
