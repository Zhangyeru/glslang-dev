#version 450 core
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_AZD_neural_matrix : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf { float16_t data[]; } buf;

// Test 8: Multiple mixed-use matrices sharing the same type (16x16)
// M_left: only left → useA
// M_right: only right → useB
// M_acc: only acc → accumulator
// M_ab: left 2x, right 1x → left >= right → useA
// M_ba: left 1x, right 2x → right > left → useB
void main()
{
    const vec2 shape16 = vec2(16.0, 16.0);
    const vec2 zeroOffset = vec2(0.0, 0.0);

    coopmatAZD<float16_t, 16, 16> M_left, M_right, M_acc, M_ab, M_ba;
    coopmatAZD<float16_t, 16, 16> D0, D1, D2, D3, D4, D5, D6;

    coopMatLoadAZD(M_left,  buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(M_right, buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(M_acc,   buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(M_ab,    buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(M_ba,    buf.data, shape16, zeroOffset, gl_RowMajorAZD);

    // M_left as left, M_right as right, M_acc as accumulator
    coopMatMulAddAZD(D0, M_left, M_right, M_acc);

    // M_ab: left 2x
    coopMatMulAddAZD(D1, M_ab, M_right, M_acc);
    coopMatMulAddAZD(D2, M_ab, M_right, M_acc);
    // M_ab: right 1x → total left=2, right=1 → useA
    coopMatMulAddAZD(D3, M_left, M_ab, M_acc);

    // M_ba: right 2x
    coopMatMulAddAZD(D4, M_left, M_ba, M_acc);
    coopMatMulAddAZD(D5, M_left, M_ba, M_acc);
    // M_ba: left 1x → total left=1, right=2 → useB
    coopMatMulAddAZD(D6, M_ba, M_right, M_acc);
}
