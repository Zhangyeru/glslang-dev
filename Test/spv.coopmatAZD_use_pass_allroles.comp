#version 450 core
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_AZD_neural_matrix : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf { float16_t data[]; } buf;

// Test 6: All role buckets with valid GLSL variables
// X is used as both A and B, which is allowed because both are OperandAB.
// C and D* variables cover the Accumulator role.
void main()
{
    const vec2 shape16 = vec2(16.0, 16.0);
    const vec2 zeroOffset = vec2(0.0, 0.0);

    coopmatAZD<float16_t, 16, 16> X;
    coopmatAZD<float16_t, 16, 16> A, B, C;
    coopmatAZD<float16_t, 16, 16> D0, D1, D2;

    coopMatLoadAZD(X, buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(A, buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(B, buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(C, buf.data, shape16, zeroOffset, gl_RowMajorAZD);

    // X as left and right: left_count == right_count, so it resolves to useA.
    coopMatMulAddAZD(D0, X, B, C);
    coopMatMulAddAZD(D1, A, X, C);
    coopMatMulAddAZD(D2, A, B, C);
}
