#version 450 core
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_AZD_neural_matrix : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf { float16_t data[]; } buf;

// Test 5: Equal left/right count is ambiguous.
// Matrix X(16x16) used as left 2x and right 2x
// left_count(2) == right_count(2) → ambiguous cooperative matrix A/B use
void main()
{
    const vec2 shape16 = vec2(16.0, 16.0);
    const vec2 zeroOffset = vec2(0.0, 0.0);

    coopmatAZD<float16_t, 16, 16> X;
    coopmatAZD<float16_t, 16, 16> B, B2, C0, C1, C2, C3;
    coopmatAZD<float16_t, 16, 16> A0, A1;
    coopmatAZD<float16_t, 16, 16> D0, D1, D2, D3;

    coopMatLoadAZD(X,  buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(B,  buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(B2, buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(A0, buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(A1, buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(C0, buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(C1, buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(C2, buf.data, shape16, zeroOffset, gl_RowMajorAZD);
    coopMatLoadAZD(C3, buf.data, shape16, zeroOffset, gl_RowMajorAZD);

    // X as left: left_count += 2
    coopMatMulAddAZD(D0, X,  B,  C0);
    coopMatMulAddAZD(D1, X,  B2, C1);
    // X as right: right_count += 2
    coopMatMulAddAZD(D2, A0, X,  C2);
    coopMatMulAddAZD(D3, A1, X,  C3);

    // left_count(2) == right_count(2) → ambiguous cooperative matrix A/B use
}
